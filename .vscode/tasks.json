{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (Debug)",
            "detail": "CMake + MSVC 编译（默认生成任务，也是调试前自动执行的任务）",
            "type": "process",
            "windows": {
                "command": "cmd",
                "args": ["/c", "${workspaceFolder}\\scripts\\build.bat"]
            },
            "linux": {
                "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build",
                "options": { "cwd": "${workspaceFolder}" }
            },
            "osx": {
                "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build",
                "options": { "cwd": "${workspaceFolder}" }
            },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "build (Release)",
            "detail": "以 Release 模式编译",
            "type": "process",
            "windows": {
                "command": "cmd",
                "args": ["/c", "${workspaceFolder}\\scripts\\build.bat", "release"]
            },
            "linux": {
                "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build",
                "options": { "cwd": "${workspaceFolder}" }
            },
            "osx": {
                "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build",
                "options": { "cwd": "${workspaceFolder}" }
            },
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "run",
            "detail": "编译并直接运行 build/bin/app.exe（不调试）",
            "type": "process",
            "windows": {
                "command": "cmd",
                "args": ["/c", "${workspaceFolder}\\scripts\\build.bat", "run"]
            },
            "linux": {
                "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build && ./build/bin/app",
                "options": { "cwd": "${workspaceFolder}" }
            },
            "osx": {
                "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build && ./build/bin/app",
                "options": { "cwd": "${workspaceFolder}" }
            },
            "presentation": { "reveal": "always" },
            "problemMatcher": []
        }
    ]
}
